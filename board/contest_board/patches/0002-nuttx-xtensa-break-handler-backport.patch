From d57ea828d5d065c45a47a48fd515465c66394c93 Mon Sep 17 00:00:00 2001
From: v-yanxingyu <v-yanxingyu@xiaomi.com>
Date: Tue, 19 May 2026 15:18:29 +0800
Subject: [PATCH] xtensa: handle BREAK and BREAK.N debug exceptions

Backport only the BREAK/BREAK.N handling hunk from the already-merged
contest compatibility commit.  The board build applies this patch temporarily
because the current checkout's debug handler no longer contains the hunk.

---
 arch/xtensa/src/common/xtensa_debug.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/xtensa/src/common/xtensa_debug.c b/arch/xtensa/src/common/xtensa_debug.c
index 0b0fd1920d1..621aa29a13c 100644
--- a/arch/xtensa/src/common/xtensa_debug.c
+++ b/arch/xtensa/src/common/xtensa_debug.c
@@ -545,6 +545,19 @@ uint32_t *xtensa_debug_handler(uint32_t *regs)
     {
       xtensa_singlestep_handler();
     }
+  else if (cause & (XCHAL_DEBUGCAUSE_BREAK_MASK |
+                    XCHAL_DEBUGCAUSE_BREAKN_MASK))
+    {
+      /* BREAK / BREAK.N instruction triggered the debug exception.
+       * Skip past the instruction (3 bytes for BREAK, 2 for BREAK.N)
+       * to avoid an infinite re-execution loop on chips that don't
+       * have an external debugger attached.  Without this, EPC stays
+       * pointing at the BREAK instruction and the handler returns
+       * straight back into it.
+       */
+
+      regs[REG_PC] += (cause & XCHAL_DEBUGCAUSE_BREAKN_MASK) ? 2 : 3;
+    }
   else
     {
       _alert("Unhandled debug cause 0x%x\n", cause);
-- 
2.34.1
