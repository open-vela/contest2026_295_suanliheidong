 #define TOOL_OUTPUT_SIZE_LARGE (16 * 1024)
 #define TOOL_OUTPUT_SIZE_MIN (2 * 1024)
 
+/* ESP32-S3 external RAM virtual-address range.  The contest configuration
+ * registers PSRAM as a heap region after the smaller internal heap. */
+#define AGENT_PSRAM_LOW  0x3c000000u
+#define AGENT_PSRAM_HIGH 0x3e000000u
+
+static bool agent_ptr_in_psram(const void* ptr)
+{
+    uintptr_t addr = (uintptr_t)ptr;
+
+    return addr >= AGENT_PSRAM_LOW && addr < AGENT_PSRAM_HIGH;
+}
+
+/*
+ * Keep long-lived agent buffers out of internal RAM.  The allocator services
+ * internal RAM first, so temporary allocations advance the request into the
+ * PSRAM heap and are returned before this function succeeds.
+ */
+static void* agent_calloc_psram(size_t size)
+{
+    void* discarded[64];
+    size_t count = 0;
+
+    while (count < sizeof(discarded) / sizeof(discarded[0])) {
+        void* ptr = calloc(1, size);
+
+        if (ptr == NULL || agent_ptr_in_psram(ptr)) {
+            while (count > 0) {
+                free(discarded[--count]);
+            }
+
+            return ptr;
+        }
+
+        discarded[count++] = ptr;
+    }
+
+    while (count > 0) {
+        free(discarded[--count]);
+    }
+
+    return NULL;
+}
+
+static int agent_pool_init_psram(agent_mem_pool_t* pool, size_t buf_size,
+    int count)
+{
+    if (count > AGENT_POOL_SLOTS) {
+        count = AGENT_POOL_SLOTS;
+    }
+
+    memset(pool, 0, sizeof(*pool));
+    pool->buf_size = buf_size;
+    pool->count = count;
+    pthread_mutex_init(&pool->lock, NULL);
+
+    for (int i = 0; i < count; i++) {
+        pool->buffers[i] = agent_calloc_psram(buf_size);
+        if (pool->buffers[i] == NULL) {
+            while (i > 0) {
+                free(pool->buffers[--i]);
+            }
+
+            pthread_mutex_destroy(&pool->lock);
+            return ERROR;
+        }
+    }
+
+    return OK;
+}
