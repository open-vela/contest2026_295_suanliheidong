+static const voice_asr_ops_t s_mimo_asr_ops = {
+    .name = MIMO_ASR_BACKEND_NAME,
+    .init = mimo_asr_init,
+    .recognize = mimo_asr_recognize,
+    .stream_open = NULL,
+    .stream_send = NULL,
+    .stream_finish = NULL,
+    .stream_abort = NULL,
+    .deinit = NULL,
