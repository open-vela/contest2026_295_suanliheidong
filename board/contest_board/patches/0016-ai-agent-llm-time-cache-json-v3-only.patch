+static size_t first_invalid_utf8(const unsigned char *data, size_t len)
+{
+    for (size_t i = 0; i < len; i++) {
+        unsigned char c = data[i];
+        size_t need;
+        uint32_t code;
+
+        if (c < 0x80) {
+            continue;
+        } else if (c >= 0xc2 && c <= 0xdf) {
+            need = 1;
+            code = c & 0x1f;
+        } else if (c >= 0xe0 && c <= 0xef) {
+            need = 2;
+            code = c & 0x0f;
+        } else if (c >= 0xf0 && c <= 0xf4) {
+            need = 3;
+            code = c & 0x07;
+        } else {
+            return i;
+        }
+
+        if (need > len - i - 1) {
+            return i;
+        }
+
+        for (size_t j = 1; j <= need; j++) {
+            if ((data[i + j] & 0xc0) != 0x80) {
+                return i + j;
+            }
+            code = (code << 6) | (data[i + j] & 0x3f);
+        }
+
+        if ((need == 1 && code < 0x80)
+            || (need == 2 && code < 0x800)
+            || (need == 3 && code < 0x10000)
+            || (code > 0x10ffff)
+            || (code >= 0xd800 && code <= 0xdfff)) {
+            return i;
+        }
+
+        i += need;
+    }
+
+    return len;
+}
+
