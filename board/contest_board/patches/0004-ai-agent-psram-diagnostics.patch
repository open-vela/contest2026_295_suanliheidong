+struct agent_heap_diag_s
+{
+    size_t internal_free;
+    size_t internal_largest;
+    size_t psram_free;
+    size_t psram_largest;
+};
+
+static const char *agent_loop_mem_kind(const void *ptr)
+{
+    uintptr_t addr = (uintptr_t)ptr;
+
+    return addr >= AGENT_LOOP_PSRAM_LOW && addr < AGENT_LOOP_PSRAM_HIGH ?
+        "PSRAM" : "INTERNAL";
+}
+
+static void agent_loop_heap_diag_node(struct mm_allocnode_s *node,
+    void *arg)
+{
+    struct agent_heap_diag_s *stats = arg;
+    size_t size;
+    size_t *free_bytes;
+    size_t *largest;
+
+    if (!MM_NODE_IS_FREE(node)) {
+        return;
+    }
+
+    size = MM_SIZEOF_NODE(node);
+    if (agent_loop_mem_kind(node)[0] == 'P') {
+        free_bytes = &stats->psram_free;
+        largest = &stats->psram_largest;
+    } else {
+        free_bytes = &stats->internal_free;
+        largest = &stats->internal_largest;
+    }
+
+    *free_bytes += size;
+    if (size > *largest) {
+        *largest = size;
+    }
+}
+
+void agent_loop_heap_diag(const char *phase)
+{
+    struct agent_heap_diag_s stats = { 0 };
+    struct mallinfo combined = mallinfo();
+
+    if (g_mmheap != NULL) {
+        mm_foreach(g_mmheap, agent_loop_heap_diag_node, &stats);
+    }
+
+    syslog(LOG_INFO,
+        "[MEM-DIAG] phase=%s internal free=%zu largest=%zu psram free=%zu largest=%zu combined free=%u largest=%u\n",
+        phase, stats.internal_free, stats.internal_largest,
+        stats.psram_free, stats.psram_largest,
+        combined.fordblks, combined.mxordblk);
+}
+
+static void *agent_loop_alloc_psram(size_t size)
+{
+    void *discarded[64];
+    int count = 0;
+    void *ptr;
+
+    while (count < (int)(sizeof(discarded) / sizeof(discarded[0]))) {
+        ptr = calloc(1, size);
+        if (!ptr || agent_loop_mem_kind(ptr)[0] == 'P') {
+            while (count > 0) {
+                free(discarded[--count]);
+            }
+            return ptr;
+        }
+
+        discarded[count++] = ptr;
+    }
+
+    while (count > 0) {
+        free(discarded[--count]);
+    }
+
+    return NULL;
+}
+
+static int agent_loop_pool_init_psram(agent_mem_pool_t *pool,
+    size_t buf_size, int count)
+{
+    if (count > AGENT_POOL_SLOTS) {
+        count = AGENT_POOL_SLOTS;
+    }
+
+    memset(pool, 0, sizeof(*pool));
+    pool->buf_size = buf_size;
+    pool->count = count;
+    pthread_mutex_init(&pool->lock, NULL);
+    for (int i = 0; i < count; i++) {
+        pool->buffers[i] = agent_loop_alloc_psram(buf_size);
+        if (!pool->buffers[i]) {
+            for (int j = 0; j < i; j++) {
+                free(pool->buffers[j]);
+            }
+            pthread_mutex_destroy(&pool->lock);
+            return ERROR;
+        }
+    }
+    return OK;
+}
