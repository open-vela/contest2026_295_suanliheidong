--- a/src/infra/network_manager.c
+++ b/src/infra/network_manager.c
@@ -18,6 +18,7 @@
 #include "agent_compat.h"
 
 #include <arpa/inet.h>
+#include <errno.h>
 #include <ifaddrs.h>
 #include <netinet/in.h>
 #include <string.h>
@@ -26,10 +27,61 @@
 #include <time.h>
 #include <unistd.h>
 
+#if !defined(CONFIG_ARCH_CHIP_GOLDFISH_ARM64) && \
+    !defined(CONFIG_ARCH_CHIP_QEMU_ARM) && \
+    !defined(CONFIG_AI_AGENT_NET_RPMSG)
+#include <netutils/netlib.h>
+#include <wireless/wapi.h>
+#endif
+
 static const char* TAG = "netmgr";
 
 static char s_ip_str[INET_ADDRSTRLEN] = "0.0.0.0";
 
+void network_sanitize_wlan0(void)
+{
+#if !defined(CONFIG_ARCH_CHIP_GOLDFISH_ARM64) && \
+    !defined(CONFIG_ARCH_CHIP_QEMU_ARM) && \
+    !defined(CONFIG_AI_AGENT_NET_RPMSG)
+    const char* dev = "wlan0";
+    int fd = wapi_make_socket();
+    int disconnect_rc = 0;
+    int disconnect_errno = 0;
+    int clear_rc = ERROR;
+    int clear_errno = 0;
+
+    if (fd < 0) {
+        disconnect_rc = fd;
+        disconnect_errno = -fd;
+        clear_rc = fd;
+        clear_errno = -fd;
+    } else {
+        /* This is the same WAPI disconnect implementation used by the
+         * `wapi disconnect wlan0` command.  Its public API is void, so the
+         * command's ioctl failures are reported by WAPI itself; the local
+         * return value records socket setup status only. */
+        errno = 0;
+        wpa_driver_wext_disconnect(fd, dev);
+        disconnect_errno = errno;
+
+        struct in_addr zero = { 0 };
+        clear_rc = wapi_set_ip(fd, dev, &zero);
+        clear_errno = clear_rc < 0 ? -clear_rc : 0;
+        close(fd);
+    }
+
+    syslog(LOG_INFO, "[WLAN-INIT] disconnect rc=%d errno=%d\n",
+        disconnect_rc, disconnect_errno);
+    syslog(LOG_INFO, "[WLAN-INIT] clear_ip rc=%d errno=%d\n",
+        clear_rc, clear_errno);
+#else
+    syslog(LOG_INFO, "[WLAN-INIT] disconnect rc=0 errno=0\n");
+    syslog(LOG_INFO, "[WLAN-INIT] clear_ip rc=0 errno=0\n");
+#endif
+
+    syslog(LOG_INFO, "[WLAN-INIT] sanitize done\n");
+}
+
 bool network_is_connected(void)
 {
     struct ifaddrs* ifa_list = NULL;
