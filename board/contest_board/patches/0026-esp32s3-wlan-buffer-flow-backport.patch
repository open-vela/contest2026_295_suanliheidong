 #define WLAN_PKTBUF_NUM           (CONFIG_ESP32S3_WLAN_PKTBUF_NUM)
 
+/*
+ * RX reserve for the shared WLAN packet-buffer pool.
+ *
+ * RX and TX currently share pktbuf[].  During a large TCP write, devif_poll()
+ * may enqueue many TX frames before wlan_transmit() gets a chance to drain
+ * txb.  With CONFIG_ESP32S3_WLAN_PKTBUF_NUM=16 this can consume the entire
+ * pool and make wlan_rx_done() fail with -ENOBUFS, dropping TCP ACKs and
+ * eventually resetting the TLS connection.
+ *
+ * Keep half of the pool unavailable to normal TX polling.  RX still uses the
+ * full pool, so receive bursts can consume the reserve when needed.
+ */
+#define WLAN_RX_RESERVED_BUFS \
+  ((WLAN_PKTBUF_NUM >= 8) ? (WLAN_PKTBUF_NUM / 2) : 2)
+
+/*
+ * Upper-layer Wi-Fi TX flow control.
+ *
+ * esp_wifi_internal_tx() uses the vendor driver's dynamic TX resources.
+ * Submitting an entire NuttX txb burst in one wlan_transmit() call can
+ * exhaust those resources and return -ENOMEM, even for small TCP ACKs.
+ *
+ * Keep only a small number of vendor TX submissions in flight.  TX-done
+ * callbacks return credits and immediately schedule more work.
+ */
+#define WLAN_WIFI_TX_INFLIGHT_MAX 4
+
+/* Vendor ESP_ERR_NO_MEM is temporary backpressure, not a reason to spin.
+ * Retry the same queued packet with bounded exponential backoff.
+ */
+
+#define WLAN_TX_RETRY_MIN_MS       10
+#define WLAN_TX_RETRY_MAX_MS       160
+#define WLAN_TX_RETRY_MAX_ATTEMPTS 8
+
+
+
+/*
+ * HTTPS/TLS receive-path diagnostics.
+ *
+ * The contest configuration currently uses CONFIG_NET_ETH_PKTSIZE=590.
+ * Log only TCP/443 traffic, with a strict rate limit, so we can determine:
+ *   - the MSS advertised in SYN/SYN-ACK;
+ *   - whether MiMo's first TLS response reaches the Wi-Fi callback;
+ *   - whether an incoming Ethernet frame exceeds WLAN_BUF_SIZE;
+ *   - whether the small wlan_pktbuf pool is exhausted.
+ *
+ * This code does not modify packets.
+ */
+#define WLAN_TLS_DIAG_PORT          443
+#define WLAN_TLS_DIAG_PAYLOAD_LIMIT 32 /* retained for source compatibility */
+
+static uint32_t g_wlan_tls_diag_frames;
+static uint32_t g_wlan_tls_rx_oversize;
+static uint32_t g_wlan_tls_rx_nobuf;
+static uint32_t g_wlan_tls_rx_work_requeue;
+static uint32_t g_wlan_tls_txdone_ok;
+static uint32_t g_wlan_tls_txdone_fail;
+
+static uint16_t wlan_diag_be16(const uint8_t *p)
+{
+  return ((uint16_t)p[0] << 8) | p[1];
+}
+
+
+static uint32_t wlan_diag_be32(const uint8_t *p)
+{
+  return ((uint32_t)p[0] << 24) |
+         ((uint32_t)p[1] << 16) |
+         ((uint32_t)p[2] << 8) |
+         (uint32_t)p[3];
+}
+
+
+static uint32_t wlan_diag_csum_add(uint32_t sum,
+                                   const uint8_t *data, size_t len)
+{
+  while (len >= 2)
+    {
+      sum += ((uint16_t)data[0] << 8) | data[1];
+      data += 2;
+      len -= 2;
+    }
+
+  if (len != 0)
+    {
+      sum += (uint16_t)data[0] << 8;
+    }
+
+  return sum;
+}
+
+static uint16_t wlan_diag_csum_fold(uint32_t sum)
+{
+  while ((sum >> 16) != 0)
+    {
+      sum = (sum & 0xffff) + (sum >> 16);
+    }
+
+  return (uint16_t)sum;
+}
+
+static bool wlan_diag_ipv4_checksum_ok(const uint8_t *ip, size_t ihl)
+{
+  uint32_t sum;
+
+  if (!ip || ihl < 20)
+    {
+      return false;
+    }
+
+  sum = wlan_diag_csum_add(0, ip, ihl);
+  return wlan_diag_csum_fold(sum) == 0xffff;
+}
+
+static bool wlan_diag_tcp_checksum_ok(const uint8_t *ip,
+                                      size_t ihl,
+                                      const uint8_t *tcp,
+                                      size_t tcp_len)
+{
+  uint32_t sum = 0;
+
+  if (!ip || !tcp || ihl < 20 || tcp_len < 20)
+    {
+      return false;
+    }
+
+  /* IPv4 pseudo-header: source, destination, zero, protocol, TCP length. */
+
+  sum = wlan_diag_csum_add(sum, ip + 12, 8);
+  sum += ip[9];
+  sum += (uint16_t)tcp_len;
+  sum = wlan_diag_csum_add(sum, tcp, tcp_len);
+
+  return wlan_diag_csum_fold(sum) == 0xffff;
+}
+
+static bool wlan_diag_is_tcp443(const void *buffer, size_t len)
+{
+  const uint8_t *frame = (const uint8_t *)buffer;
+  size_t ipoff = 14;
+  size_t ihl;
+  size_t tcpoff;
+  uint16_t src;
+  uint16_t dst;
+
+  if (!frame || len < 14 + 20)
+    {
+      return false;
+    }
+
+  if (frame[12] != 0x08 || frame[13] != 0x00)
+    {
+      return false;
+    }
+
+  ihl = (size_t)(frame[ipoff] & 0x0f) * 4;
+  if (ihl < 20 || len < ipoff + ihl + 20 || frame[ipoff + 9] != 6)
+    {
+      return false;
+    }
+
+  tcpoff = ipoff + ihl;
+  src = wlan_diag_be16(frame + tcpoff);
+  dst = wlan_diag_be16(frame + tcpoff + 2);
+
+  return src == WLAN_TLS_DIAG_PORT || dst == WLAN_TLS_DIAG_PORT;
+}
+
+static int wlan_diag_tcp_mss(const uint8_t *tcp, size_t tcp_hlen)
+{
+  size_t off = 20;
+
+  if (tcp_hlen <= 20)
+    {
+      return -1;
+    }
+
+  while (off < tcp_hlen)
+    {
+      uint8_t kind = tcp[off];
+
+      if (kind == 0)
+        {
+          break;
+        }
+
+      if (kind == 1)
+        {
+          off++;
+          continue;
+        }
+
+      if (off + 1 >= tcp_hlen)
+        {
+          break;
+        }
+
+      uint8_t optlen = tcp[off + 1];
+      if (optlen < 2 || off + optlen > tcp_hlen)
+        {
+          break;
+        }
+
+      if (kind == 2 && optlen == 4)
+        {
+          return (int)wlan_diag_be16(tcp + off + 2);
+        }
+
+      off += optlen;
+    }
+
+  return -1;
+}
+
+static void wlan_diag_tls_frame(const char *dir, const void *buffer, size_t len)
+{
+  const uint8_t *frame = (const uint8_t *)buffer;
+  size_t ipoff = 14;
+  size_t ihl;
+  size_t tcpoff;
+  size_t tcp_hlen;
+  uint16_t src;
+  uint16_t dst;
+  uint16_t ip_total;
+  uint8_t flags;
+  size_t payload;
+  int mss = -1;
+  uint32_t seq;
+  uint32_t ackno;
+  uint16_t wnd;
+  size_t tcp_len;
+  bool ip_csum_ok;
+  bool tcp_csum_ok;
+  bool control;
+
+  if (!frame || len < 14 + 20)
+    {
+      return;
+    }
+
+  /* Ethernet IPv4 only. */
+  if (frame[12] != 0x08 || frame[13] != 0x00)
+    {
+      return;
+    }
+
+  ihl = (size_t)(frame[ipoff] & 0x0f) * 4;
+  if (ihl < 20 || len < ipoff + ihl || frame[ipoff + 9] != 6)
+    {
+      return;
+    }
+
+  tcpoff = ipoff + ihl;
+  if (len < tcpoff + 20)
+    {
+      return;
+    }
+
+  src = wlan_diag_be16(frame + tcpoff);
+  dst = wlan_diag_be16(frame + tcpoff + 2);
+  if (src != WLAN_TLS_DIAG_PORT && dst != WLAN_TLS_DIAG_PORT)
+    {
+      return;
+    }
+
+  ip_total = wlan_diag_be16(frame + ipoff + 2);
+  tcp_hlen = (size_t)(frame[tcpoff + 12] >> 4) * 4;
+  if (tcp_hlen < 20 || len < tcpoff + tcp_hlen)
+    {
+      return;
+    }
+
+  flags = frame[tcpoff + 13];
+  payload = ip_total >= ihl + tcp_hlen ?
+            (size_t)ip_total - ihl - tcp_hlen : 0;
+  control = (flags & (0x02 | 0x01 | 0x04)) != 0; /* SYN/FIN/RST */
+  seq = wlan_diag_be32(frame + tcpoff + 4);
+  ackno = wlan_diag_be32(frame + tcpoff + 8);
+  wnd = wlan_diag_be16(frame + tcpoff + 14);
+  tcp_len = ip_total >= ihl ? (size_t)ip_total - ihl : 0;
+  ip_csum_ok = wlan_diag_ipv4_checksum_ok(frame + ipoff, ihl);
+  tcp_csum_ok = wlan_diag_tcp_checksum_ok(frame + ipoff, ihl,
+                                          frame + tcpoff, tcp_len);
+
+  if ((flags & 0x02) != 0)
+    {
+      mss = wlan_diag_tcp_mss(frame + tcpoff, tcp_hlen);
+    }
+
+  /*
+   * For this run, keep pure ACKs too.  They tell us whether the peer ACKed
+   * the 149-byte ClientHello even when it sends no TLS response record.
+   * A single global limit prevents the diagnostic from flooding the console.
+   */
+  if (!control && g_wlan_tls_diag_frames >= 80)
+    {
+      return;
+    }
+
+  g_wlan_tls_diag_frames++;
+
+  syslog(LOG_INFO,
+         "[WLAN-TLS] %s frame=%zu max=%u ip_total=%u "
+         "tcp_hlen=%zu payload=%zu flags=0x%02x "
+         "src=%u dst=%u seq=%" PRIu32 " ack=%" PRIu32
+         " wnd=%u mss=%d ipcsum=%s tcpcsum=%s\n",
+         dir ? dir : "?",
+         len, (unsigned int)WLAN_BUF_SIZE, (unsigned int)ip_total,
+         tcp_hlen, payload, flags,
+         (unsigned int)src, (unsigned int)dst,
+         seq, ackno, (unsigned int)wnd, mss,
+         ip_csum_ok ? "OK" : "BAD",
+         tcp_csum_ok ? "OK" : "BAD");
+}
