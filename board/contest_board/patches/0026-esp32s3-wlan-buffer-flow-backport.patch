+static void wlan_recycle_queues_locked(struct wlan_priv_s *priv)
+{
+  sq_entry_t *entry;
+
+  while ((entry = sq_remfirst(&priv->rxb)) != NULL)
+    {
+      DEBUGASSERT(priv->rxb_count > 0);
+      priv->rxb_count--;
+      priv->rx_dequeued++;
+      sq_addlast(entry, &priv->freeb);
+      DEBUGASSERT(priv->free_count < WLAN_PKTBUF_NUM);
+      priv->free_count++;
+      priv->buf_recycled++;
+    }
+
+  while ((entry = sq_remfirst(&priv->txb)) != NULL)
+    {
+      sq_addlast(entry, &priv->freeb);
+      DEBUGASSERT(priv->free_count < WLAN_PKTBUF_NUM);
+      priv->free_count++;
+      priv->buf_recycled++;
+    }
+
+  if (priv->dev.d_buf != NULL)
+    {
+      struct wlan_pktbuf *pktbuf;
+
+      pktbuf = container_of(priv->dev.d_buf, struct wlan_pktbuf, buffer);
+      sq_addlast(&pktbuf->entry, &priv->freeb);
+      DEBUGASSERT(priv->free_count < WLAN_PKTBUF_NUM);
+      priv->free_count++;
+      priv->buf_recycled++;
+      priv->dev.d_buf = NULL;
+      priv->dev.d_len = 0;
+    }
+
+  priv->rx_work_pending = false;
+}
+
+static void wlan_rx_stats_report(struct wlan_priv_s *priv,
+                                 const char *reason)
+{
+  irqstate_t flags;
+  uint16_t free_count;
+  uint16_t free_min;
+  uint16_t rxb_count;
+  uint16_t rxb_highwater;
+  uint32_t rx_enqueued;
+  uint32_t rx_dequeued;
+  uint32_t buf_recycled;
+  uint32_t work_scheduled;
+  uint32_t work_failed;
+
+  flags = spin_lock_irqsave(&priv->lock);
+  free_count = priv->free_count;
+  free_min = priv->free_min;
+  rxb_count = priv->rxb_count;
+  rxb_highwater = priv->rxb_highwater;
+  rx_enqueued = priv->rx_enqueued;
+  rx_dequeued = priv->rx_dequeued;
+  buf_recycled = priv->buf_recycled;
+  work_scheduled = priv->rx_work_scheduled;
+  work_failed = priv->rx_work_failed;
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  syslog(LOG_INFO,
+         "[WLAN-RX] stats reason=%s free=%u free_min=%u "
+         "rxb=%u rxb_high=%u enq=%" PRIu32 " deq=%" PRIu32
+         " recycled=%" PRIu32 " work=%" PRIu32 " work_fail=%" PRIu32
+         " nobuf=%" PRIu32 " requeue=%" PRIu32 "\n",
+         reason ? reason : "?", (unsigned int)free_count,
+         (unsigned int)free_min, (unsigned int)rxb_count,
+         (unsigned int)rxb_highwater, rx_enqueued, rx_dequeued,
+         buf_recycled, work_scheduled, work_failed,
+         g_wlan_tls_rx_nobuf, g_wlan_tls_rx_work_requeue);
+}
+
+static void wlan_rxwork_schedule_retry(struct wlan_priv_s *priv)
+{
+  int ret;
+
+  if (!priv->ifup)
+    {
+      return;
+    }
+
+  ret = wd_start(&priv->rxretrytimer, 1, wlan_rxwork_retry_expiry,
+                 (wdparm_t)priv);
+  if (ret < 0)
+    {
+      irqstate_t flags = spin_lock_irqsave(&priv->lock);
+
+      priv->rx_work_pending = false;
+      priv->rx_work_failed++;
+      spin_unlock_irqrestore(&priv->lock, flags);
+      wlan_rx_stats_report(priv, "retry-timer-failed");
+    }
+}
 
+static void wlan_rxwork_retry_expiry(wdparm_t arg)
+{
+  struct wlan_priv_s *priv = (struct wlan_priv_s *)arg;
+  irqstate_t flags;
+  bool schedule = false;
+  int ret;
+
+  flags = spin_lock_irqsave(&priv->lock);
+  if (priv->ifup && !sq_empty(&priv->rxb) && !priv->rx_work_pending)
+    {
+      priv->rx_work_pending = true;
+      priv->rx_work_scheduled++;
+      schedule = true;
+    }
+  else if (!priv->ifup || sq_empty(&priv->rxb))
+    {
+      priv->rx_work_pending = false;
+    }
   spin_unlock_irqrestore(&priv->lock, flags);
+
+  if (!schedule)
+    {
+      return;
+    }
+
+  ret = work_queue(WLAN_WORK, &priv->rxwork, wlan_rxpoll, priv, 0);
+  if (ret < 0)
+    {
+      flags = spin_lock_irqsave(&priv->lock);
+      priv->rx_work_pending = false;
+      priv->rx_work_failed++;
+      spin_unlock_irqrestore(&priv->lock, flags);
+
+      wlan_rx_stats_report(priv, "retry-schedule-failed");
+      wlan_rxwork_schedule_retry(priv);
+    }
 }
 
