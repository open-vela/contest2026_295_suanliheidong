+/****************************************************************************
+ * Function: wlan_alloc_tx_buffer
+ *
+ * Description:
+ *   Allocate a buffer for normal TX polling while preserving a receive-side
+ *   reserve.  This prevents a large TCP write from consuming every shared
+ *   packet buffer before inbound ACKs can be queued.
+ ****************************************************************************/
+
+static inline struct wlan_pktbuf *
+wlan_alloc_tx_buffer(struct wlan_priv_s *priv)
+{
+  static uint32_t reserve_hits;
+  struct wlan_pktbuf *pktbuf = NULL;
+  sq_entry_t *entry;
+  irqstate_t flags;
+
+  flags = spin_lock_irqsave(&priv->lock);
+
+  if (priv->free_count > WLAN_RX_RESERVED_BUFS)
+    {
+      entry = sq_remfirst(&priv->freeb);
+      if (entry)
+        {
+          pktbuf = container_of(entry, struct wlan_pktbuf, entry);
+          DEBUGASSERT(priv->free_count > 0);
+          priv->free_count--;
+          if (priv->free_count < priv->free_min)
+            {
+              priv->free_min = priv->free_count;
+            }
+        }
+    }
+  else
+    {
+      reserve_hits++;
+
+      /* Keep diagnostics useful without flooding the serial console. */
+
+      if (reserve_hits <= 8 || (reserve_hits & 0x1f) == 0)
+        {
+          syslog(LOG_INFO,
+                 "[WLAN-BUF] TX reserve hit=%" PRIu32
+                 " free=%u reserve=%u total=%u\n",
+                 reserve_hits,
+                 (unsigned int)priv->free_count,
+                 (unsigned int)WLAN_RX_RESERVED_BUFS,
+                 (unsigned int)WLAN_PKTBUF_NUM);
+        }
+    }
+
+  spin_unlock_irqrestore(&priv->lock, flags);
+  return pktbuf;
+}
+
+
+/****************************************************************************
+ * Function: wlan_tx_credit_take
+ *
+ * Description:
+ *   Reserve one vendor Wi-Fi TX in-flight slot.
+ ****************************************************************************/
+
+static bool wlan_tx_credit_take(struct wlan_priv_s *priv)
+{
+  irqstate_t flags;
+  bool ok = false;
+
+  flags = spin_lock_irqsave(&priv->lock);
+
+  if (priv->tx_inflight < WLAN_WIFI_TX_INFLIGHT_MAX)
+    {
+      priv->tx_inflight++;
+      ok = true;
+    }
+
+  spin_unlock_irqrestore(&priv->lock, flags);
+  return ok;
+}
+
+/****************************************************************************
+ * Function: wlan_tx_credit_release
+ *
+ * Description:
+ *   Release one vendor Wi-Fi TX in-flight slot.  The guard makes this robust
+ *   if a vendor callback is observed for a frame that was not counted by the
+ *   upper-half.
+ ****************************************************************************/
+
+static uint16_t wlan_tx_credit_release(struct wlan_priv_s *priv)
+{
+  irqstate_t flags;
+  uint16_t value;
+
+  flags = spin_lock_irqsave(&priv->lock);
+
+  if (priv->tx_inflight > 0)
+    {
+      priv->tx_inflight--;
+    }
+
+  value = priv->tx_inflight;
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  return value;
+}
+
+static uint16_t wlan_tx_credit_count(struct wlan_priv_s *priv)
+{
+  irqstate_t flags;
+  uint16_t value;
+
+  flags = spin_lock_irqsave(&priv->lock);
+  value = priv->tx_inflight;
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  return value;
+}
+
+
+static bool wlan_tx_retry_is_pending(struct wlan_priv_s *priv)
+{
+  irqstate_t flags;
+  bool pending;
+
+  flags = spin_lock_irqsave(&priv->lock);
+  pending = priv->tx_retry_pending;
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  return pending;
+}
+
+static void wlan_tx_retry_reset(struct wlan_priv_s *priv)
+{
+  irqstate_t flags;
+
+  flags = spin_lock_irqsave(&priv->lock);
+  priv->tx_retry_ms = WLAN_TX_RETRY_MIN_MS;
+  priv->tx_retry_count = 0;
+  spin_unlock_irqrestore(&priv->lock, flags);
+}
+
+static uint32_t wlan_tx_retry_count(struct wlan_priv_s *priv)
+{
+  irqstate_t flags;
+  uint32_t count;
+
+  flags = spin_lock_irqsave(&priv->lock);
+  count = priv->tx_retry_count;
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  return count;
+}
+
+static void wlan_txretry_work(void *arg)
+{
+  struct wlan_priv_s *priv = (struct wlan_priv_s *)arg;
+  irqstate_t flags;
+  uint32_t retry_count;
+
+  flags = spin_lock_irqsave(&priv->lock);
+  priv->tx_retry_pending = false;
+  retry_count = priv->tx_retry_count;
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  if (!priv->ifup)
+    {
+      return;
+    }
+
+  syslog(LOG_INFO,
+         "[WLAN-TXFLOW] retry fire=%" PRIu32 " free=%u inflight=%u\n",
+         retry_count,
+         (unsigned int)priv->free_count,
+         (unsigned int)wlan_tx_credit_count(priv));
+
+  wlan_transmit(priv);
+
+  if (!wlan_tx_retry_is_pending(priv))
+    {
+      wlan_txavail(&priv->dev);
+    }
+}
+
+static void wlan_txretry_expiry(wdparm_t arg)
+{
+  struct wlan_priv_s *priv = (struct wlan_priv_s *)arg;
+
+  if (work_available(&priv->retrywork))
+    {
+      work_queue(WLAN_WORK, &priv->retrywork, wlan_txretry_work, priv, 0);
+    }
+  else
+    {
+      /* Previous retry work is still unwinding. Try again next tick. */
+
+      wd_start(&priv->retrytimer, 1, wlan_txretry_expiry, (wdparm_t)priv);
+    }
+}
+
+static void wlan_tx_retry_schedule(struct wlan_priv_s *priv)
+{
+  irqstate_t flags;
+  uint16_t delay_ms = 0;
+  uint32_t retry_count = 0;
+  uint32_t delay_ticks;
+  bool schedule = false;
+  int ret;
+
+  flags = spin_lock_irqsave(&priv->lock);
+
+  if (!priv->tx_retry_pending)
+    {
+      delay_ms = priv->tx_retry_ms;
+      priv->tx_retry_pending = true;
+      priv->tx_retry_count++;
+      retry_count = priv->tx_retry_count;
+
+      if (priv->tx_retry_ms < WLAN_TX_RETRY_MAX_MS)
+        {
+          uint32_t next = (uint32_t)priv->tx_retry_ms * 2;
+
+          priv->tx_retry_ms =
+            next > WLAN_TX_RETRY_MAX_MS ? WLAN_TX_RETRY_MAX_MS :
+                                          (uint16_t)next;
+        }
+
+      schedule = true;
+    }
+
+  spin_unlock_irqrestore(&priv->lock, flags);
